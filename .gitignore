# Browser-automation temp profiles: real cookies, saved passwords, and
# trust tokens live here, never project content. Committed once by
# accident on 2026-09-03 (blanket `git add -A`) and removed the same
# commit; ignored from here on so it can't happen again.
.tmp-chrome-*/

# Compiled LLVM pieces, their debug symbols, and the per-compile identity
# logs. All of it is generated and all of it is large: 135 MB as of
# 2026-09-18, of which .piece is 94 MB and .pdb symbols are 26 MB. The
# pieces are live inputs to examples/llvm_dt_system.py, so this directory
# is kept locally and rebuilt -- it is ignored, not deleted.
/artifacts/

# Symbolic law construction cache, rebuilt on demand.
__lawcache__/
