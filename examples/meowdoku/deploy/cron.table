# The live service's schedule, read by the Nodus cron tool (nodus include/cron_tool.h).
# Installed as <state>/jobs/cron/cron.table when that file does not exist yet; edit the installed copy.
#
#   <name> <minute> <hour> <day-of-month> <month> <day-of-week> [missed=skip|once|all] [max_late=SECONDS] [max_catch_up=N]
#
# Times are UTC. After a gap, "once" runs a missed task one time for the whole gap; "skip" never runs missed
# occurrences; "all" runs each one (the most recent max_catch_up of them).

# Check that the published hard copy of the manual still matches the manual; rebuild it when it does not.
manual.hardcopy 17 * * * * missed=once

# One snapshot of the state root each night (09:30 UTC): the databases and the text files, no binary files, and
# only the last one is kept (no rolling window). Binary products are a different policy. After a gap, one run covers it.
state.backup 30 9 * * * missed=once

# Land the changes whose review is accepted (branch_review.py), every ten minutes. While the branch policy's
# apply is false this only reports what it would land.
reviews.land */10 * * * * missed=once

# Once a day (09:45 UTC), remove branches that have been fully merged for the policy's grace period. While the
# branch policy's apply is false this only reports what it would remove.
branches.clean 45 9 * * * missed=once
