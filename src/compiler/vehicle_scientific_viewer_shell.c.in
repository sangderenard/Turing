/* Compiler-emitted native scientific vehicle viewer.
 *
 * Thread architecture: the SDL/OpenGL thread owns events, camera, geometry
 * upload, and display swap only.  A dedicated physics thread owns every
 * compiled kernel invocation and publishes complete frames through a
 * generation-tagged double buffer (the DisplayDoubleBufferABI discipline:
 * front/back plus generation).  UI edits travel to physics as an explicit
 * command queue, so Space/pause takes effect at the next window boundary
 * while the last complete snapshot stays drawable.
 */
#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <GL/gl.h>
#include <math.h>
#include <stdint.h>
#include <ctype.h>
