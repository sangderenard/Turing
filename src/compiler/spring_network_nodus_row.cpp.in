// Generated from the SymPy spring law's LLVM artifact by build_spring_nodus_row.py.
// Configuration: F64 [8,256,38] tensor. Tick: F64 scalar tensor (seconds).
// Field 37 of node zero in each network is the stable fabric identity.
// Output: F64 [8,256,3] positions. One row instance owns one batch of networks.
#include "tool_api.h"
#include "common/tensors/abstraction/tensor_abi.h"
#include "common/tensors/abstraction/abstract_tensor_handle.h"
#include <array>
#include <algorithm>
#include <cmath>
#include <cstdint>
